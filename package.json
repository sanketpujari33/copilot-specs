        "toolReferenceName": "specDetails",
        "icon": "$(document)",
        "userDescription": "Get requirements, design, and tasks for a feature spec",
        "modelDescription": "Gets full requirements, architecture design, and implementation tasks for a specific feature spec by name. Use this to inspect feature specifications.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "specName": {
              "type": "string",
              "description": "Name of the feature spec"
            }
          },
          "required": [
            "specName"
          ]
        }
      },
      {
        "name": "copilotSpecs_getTaskContext",
        "displayName": "Get Task Implementation Context",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "taskContext",
        "icon": "$(play)",
        "userDescription": "Get complete task context (requirements, design, linked files) for implementing a spec task",
        "modelDescription": "Gets rich context for a spec task, including task metadata, linked EARS requirement text, design document excerpts, and linked source code files. Use this before implementing any task.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "specName": {
              "type": "string",
              "description": "Name of the feature spec"
            },
            "taskId": {
              "type": "string",
              "description": "ID of the task (e.g. T1, T2)"
            }
          },
          "required": [
            "specName",
            "taskId"
          ]
        }
      },
      {
        "name": "copilotSpecs_markTaskComplete",
        "displayName": "Mark Spec Task Complete",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "completeSpecTask",
        "icon": "$(check)",
        "userDescription": "Mark a feature spec task and its subtasks as complete",
        "modelDescription": "Marks a spec task and all its subtasks as completed. Use this after successfully implementing a task.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "specName": {
              "type": "string",
              "description": "Name of the feature spec"
            },
            "taskId": {
              "type": "string",
              "description": "ID of the task (e.g. T1, T2)"
            }
          },
          "required": [
            "specName",
            "taskId"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Copilot Specs",
      "properties": {
        "copilot-specs.hooksEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable agent hooks that run automatically on file save events."
        },
        "copilot-specs.autopilotConfirmEachTask": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before applying each task's code changes in autopilot mode."
        },
        "copilot-specs.defaultSpecTemplate": {
          "type": "string",
          "enum": [
            "feature",
            "bugfix"
          ],
          "default": "feature",
          "description": "Default spec template to use when creating a new spec."
        },
        "copilot-specs.preferredModelFamily": {
          "type": "string",
          "default": "",
          "description": "Preferred model family for Copilot Specs (e.g., local, lemonade, gpt-4o, claude-3.5-sonnet)."
        },
        "copilot-specs.preferredModelVendor": {
          "type": "string",
          "default": "",
          "description": "Preferred model vendor for Copilot Specs (e.g., lemonade, ollama, copilot)."
        }
      }
    }
