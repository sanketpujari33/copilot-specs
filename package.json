{
  "name": "copilot-specs",
  "displayName": "Copilot Specs",
  "description": "Spec-driven development with GitHub Copilot — requirements, design, and task tracking linked to your code.",
  "version": "0.1.12",
  "publisher": "moonolgerd",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonolgerd/copilot-specs.git"
  },
  "homepage": "https://github.com/moonolgerd/copilot-specs#readme",
  "bugs": {
    "url": "https://github.com/moonolgerd/copilot-specs/issues"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "keywords": [
    "copilot",
    "specifications",
    "requirements",
    "task-management",
    "ai"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.github"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "chatParticipants": [
      {
        "id": "copilot-specs.spec",
        "name": "spec",
        "fullName": "Copilot Specs",
        "description": "Create and manage feature specs with requirements, design docs, and task lists.",
        "isWithImplicitVariables": true,
        "isSticky": false,
        "commands": [
          {
            "name": "create",
            "description": "Create a new spec with Copilot-generated content"
          },
          {
            "name": "regenerate",
            "description": "Regenerate a section (requirements, design, or tasks)"
          },
          {
            "name": "implement",
            "description": "Get implementation context prompt for a task"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "copilot-specs.newSpec",
        "title": "New Feature Spec",
        "category": "Copilot Specs",
        "icon": "$(add)"
      },
      {
        "command": "copilot-specs.newBugfixSpec",
        "title": "New Bugfix Spec",
        "category": "Copilot Specs",
        "icon": "$(bug)"
      },
      {
        "command": "copilot-specs.newQuickSpec",
        "title": "New Quick Spec",
        "category": "Copilot Specs",
        "icon": "$(zap)"
      },
      {
        "command": "copilot-specs.createSpecWizard",
        "title": "New Spec Wizard",
        "category": "Copilot Specs",
        "icon": "$(wand)"
      },
      {
        "command": "copilot-specs.deleteSpec",
        "title": "Delete Spec",
        "category": "Copilot Specs",
        "icon": "$(trash)"
      },
      {
        "command": "copilot-specs.renameSpec",
        "title": "Rename Spec",
        "category": "Copilot Specs"
      },
      {
        "command": "copilot-specs.openSpec",
        "title": "Open Spec",
        "category": "Copilot Specs",
        "icon": "$(file-text)"
      },
      {
        "command": "copilot-specs.openSpecFile",
        "title": "Open Spec File",
        "category": "Copilot Specs",
        "icon": "$(file-text)"
      },
      {
        "command": "copilot-specs.openSpecRequirements",
        "title": "Open Spec Requirements",
        "category": "Copilot Specs",
        "icon": "$(list-ordered)"
      },
      {
        "command": "copilot-specs.openSpecDesign",
        "title": "Open Spec Design",
        "category": "Copilot Specs",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "copilot-specs.openSpecTasks",
        "title": "Open Spec Tasks",
        "category": "Copilot Specs",
        "icon": "$(checklist)"
      },
      {
        "command": "copilot-specs.generateWithCopilot",
        "title": "Generate with Copilot",
        "category": "Copilot Specs",
        "icon": "$(sparkle)"
      },
      {
        "command": "copilot-specs.runAllTasks",
        "title": "Verify All Tasks with Copilot",
        "category": "Copilot Specs",
        "icon": "$(run-all)"
      },
      {
        "command": "copilot-specs.runRequiredTasks",
        "title": "Run Required Tasks with Copilot",
        "category": "Copilot Specs",
        "icon": "$(check-all)"
      },
      {
        "command": "copilot-specs.toggleTaskRequired",
        "title": "Toggle Task Required (*)",
        "category": "Copilot Specs",
        "icon": "$(list-ordered)"
      },
      {
        "command": "copilot-specs.startImplementation",
        "title": "Start Implementation",
        "category": "Copilot Specs",
        "icon": "$(play)"
      },
      {
        "command": "copilot-specs.startTask",
        "title": "Start Task with Copilot",
        "category": "Copilot Specs",
        "icon": "$(play)"
      },
      {
        "command": "copilot-specs.markTaskComplete",
        "title": "Mark Task and Sub-tasks Complete",
        "category": "Copilot Specs",
        "icon": "$(check)"
      },
      {
        "command": "copilot-specs.checkTask",
        "title": "Mark Task Complete",
        "category": "Copilot Specs"
      },
      {
        "command": "copilot-specs.uncheckTask",
        "title": "Mark Task Incomplete",
        "category": "Copilot Specs"
      },
      {
        "command": "copilot-specs.linkFileToTask",
        "title": "Link Current File to Task",
        "category": "Copilot Specs",
        "icon": "$(link)"
      },
      {
        "command": "copilot-specs.linkExistingTaskToImplementation",
        "title": "Auto-Link Tasks to Implementation",
        "category": "Copilot Specs",
        "icon": "$(references)"
      },
      {
        "command": "copilot-specs.openTaskImplementations",
        "title": "Open Task Implementations",
        "category": "Copilot Specs",
        "icon": "$(go-to-file)"
      },
      {
        "command": "copilot-specs.openTaskInTasksDocument",
        "title": "Open Task In Tasks Document",
        "category": "Copilot Specs",
        "icon": "$(list-selection)"
      },
      {
        "command": "copilot-specs.openRequirementTasks",
        "title": "Show Tasks For Requirement",
        "category": "Copilot Specs",
        "icon": "$(list-selection)"
      },
      {
        "command": "copilot-specs.openTaskRequirements",
        "title": "Show Requirements For Task",
        "category": "Copilot Specs",
        "icon": "$(list-selection)"
      },
      {
        "command": "copilot-specs.openTaskReferencedFiles",
        "title": "Open Referenced Task Files",
        "category": "Copilot Specs",
        "icon": "$(file)"
      },
      {
        "command": "copilot-specs.showRequirementTaskMap",
        "title": "Debug: Requirement Task Map",
        "category": "Copilot Specs",
        "icon": "$(debug)"
      },
      {
        "command": "copilot-specs.newSteering",
        "title": "New Rules, Skill, or Prompt",
        "category": "Copilot Specs",
        "icon": "$(add)"
      },
      {
        "command": "copilot-specs.evaluateSteeringFile",
        "title": "Analyze Chat Customization",
        "category": "Copilot Specs",
        "icon": "$(beaker)"
      },
      {
        "command": "copilot-specs.evaluateAllSteering",
        "title": "Evaluate All Chat Customizations",
        "category": "Copilot Specs",
        "icon": "$(beaker)"
      },
      {
        "command": "copilot-specs.newPrompt",
        "title": "New Prompt",
        "category": "Copilot Specs",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "copilot-specs.newWorkflow",
        "title": "New Workflow",
        "category": "Copilot Specs",
        "icon": "$(play-circle)"
      },
      {
        "command": "copilot-specs.editSteering",
        "title": "Edit Instructions File",
        "category": "Copilot Specs",
        "icon": "$(edit)"
      },
      {
        "command": "copilot-specs.newHook",
        "title": "New Agent Hook",
        "category": "Copilot Specs",
        "icon": "$(add)"
      },
      {
        "command": "copilot-specs.runHook",
        "title": "Run Hook Manually",
        "category": "Copilot Specs",
        "icon": "$(run)"
      },
      {
        "command": "copilot-specs.toggleHook",
        "title": "Toggle Hook",
        "category": "Copilot Specs",
        "icon": "$(sync)"
      },
      {
        "command": "copilot-specs.enableHook",
        "title": "Enable Hook",
        "category": "Copilot Specs",
        "icon": "$(play)"
      },
      {
        "command": "copilot-specs.disableHook",
        "title": "Disable Hook",
        "category": "Copilot Specs",
        "icon": "$(circle-slash)"
      },
      {
        "command": "copilot-specs.autopilot",
        "title": "Autopilot: Execute All Tasks",
        "category": "Copilot Specs",
        "icon": "$(rocket)"
      },
      {
        "command": "copilot-specs.selectModel",
        "title": "Select Language Model",
        "category": "Copilot Specs",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "copilot-specs.refreshExplorer",
        "title": "Refresh",
        "category": "Copilot Specs",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-specs.openMcpConfig",
        "title": "Open MCP Config",
        "category": "Copilot Specs",
        "icon": "$(go-to-file)"
      },
      {
        "command": "copilot-specs.openWorkspaceMcpConfig",
        "title": "Open Workspace MCP Config",
        "category": "Copilot Specs",
        "icon": "$(go-to-file)"
      },
      {
        "command": "copilot-specs.focusMcpPane",
        "title": "Focus MCP Servers Pane",
        "category": "Copilot Specs",
        "icon": "$(panel-bottom)"
      },
      {
        "command": "copilot-specs.toggleMcpServer",
        "title": "Toggle MCP Server",
        "category": "Copilot Specs",
        "icon": "$(sync)"
      },
      {
        "command": "copilot-specs.enableMcpServer",
        "title": "Enable MCP Server",
        "category": "Copilot Specs",
        "icon": "$(play)"
      },
      {
        "command": "copilot-specs.disableMcpServer",
        "title": "Disable MCP Server",
        "category": "Copilot Specs",
        "icon": "$(circle-slash)"
      },
      {
        "command": "copilot-specs.todo.refresh",
        "title": "Refresh Todos",
        "category": "Developer Todos",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-specs.todo.showFilterMenu",
        "title": "Filter Todos",
        "category": "Developer Todos",
        "icon": "$(filter)"
      },
      {
        "command": "copilot-specs.todo.filterAll",
