      },
      {
        "command": "copilot-specs.todo.unignoreTodo",
        "title": "Unignore Todo",
        "category": "Developer Todos",
        "icon": "$(circle-outline)"
      },
      {
        "command": "copilot-specs.todo.navigateToFile",
        "title": "Navigate to File",
        "category": "Developer Todos",
        "icon": "$(go-to-file)"
      },
      {
        "command": "copilot-specs.todo.openFile",
        "title": "Open File",
        "category": "Developer Todos"
      },
      {
        "command": "copilot-specs.todo.showTemplate",
        "title": "Show Template Details",
        "category": "Developer Todos"
      },
      {
        "command": "copilot-specs.todo.clearBranchTodos",
        "title": "Clear All Todos for Current Branch",
        "category": "Developer Todos",
        "icon": "$(clear-all)"
      },
      {
        "command": "copilot-specs.todo.addTodo",
        "title": "Add New Todo",
        "category": "Developer Todos",
        "icon": "$(add)"
      },
      {
        "command": "copilot-specs.todo.selectPreset",
        "title": "Select Template Preset",
        "category": "Developer Todos",
        "icon": "$(list-unordered)"
      },
      {
        "command": "developerTodos.refresh",
        "title": "Refresh Todos",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.showFilterMenu",
        "title": "Filter Todos",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.filterAll",
        "title": "Show All Todos",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.filterRemaining",
        "title": "Show Remaining Only",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.filterCompleted",
        "title": "Show Completed Only",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.filterIgnored",
        "title": "Show Ignored Only",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.completeTodo",
        "title": "Complete Todo",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.reopenTodo",
        "title": "Reopen Todo",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.ignoreTodo",
        "title": "Ignore/Skip Todo",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.unignoreTodo",
        "title": "Unignore Todo",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.navigateToFile",
        "title": "Navigate to File",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.openFile",
        "title": "Open File",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.showTemplate",
        "title": "Show Template Details",
        "category": "Developer Todos"
      },
      {
        "command": "developerTodos.clearBranchTodos",
        "title": "Clear All Todos for Current Branch",
        "category": "Developer Todos"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-specs-container",
          "title": "Copilot Specs",
          "icon": "$(tasklist)"
        }
      ],
      "panel": [
        {
          "id": "copilot-specs-mcp-container",
          "title": "MCP Servers",
          "icon": "$(plug)"
        }
      ]
    },
    "views": {
      "copilot-specs-container": [
        {
          "id": "copilot-specs.specExplorer",
          "name": "Specs",
          "contextualTitle": "Copilot Specs"
        },
        {
          "id": "copilot-specs.steeringExplorer",
          "name": "Instructions & Skills",
          "contextualTitle": "Instructions & Skills"
        },
        {
          "id": "copilot-specs.hooksExplorer",
          "name": "Agent Hooks",
          "contextualTitle": "Agent Hooks"
        },
        {
          "id": "copilot-specs.mcpServersExplorerSidebar",
          "name": "MCP Servers",
          "contextualTitle": "Workspace & User MCP Servers",
          "visibility": "visible"
        },
        {
          "id": "copilot-specs.developerTodosView",
          "name": "Developer Todos",
          "contextualTitle": "Branch-aware Developer Todos"
        }
      ],
      "copilot-specs-mcp-container": [
        {
          "id": "copilot-specs.mcpServersExplorer",
          "name": "MCP Servers",
          "contextualTitle": "Workspace & User MCP Servers",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilot-specs.createSpecWizard",
          "when": "view == copilot-specs.specExplorer",
          "group": "navigation@1"
        },
        {
          "command": "copilot-specs.newSpec",
          "when": "view == copilot-specs.specExplorer",
          "group": "navigation@2"
        },
        {
          "command": "copilot-specs.newBugfixSpec",
          "when": "view == copilot-specs.specExplorer",
          "group": "navigation@3"
        },
        {
          "command": "copilot-specs.newQuickSpec",
          "when": "view == copilot-specs.specExplorer",
          "group": "navigation@4"
        },
        {
          "command": "copilot-specs.refreshExplorer",
          "when": "view == copilot-specs.specExplorer",
          "group": "navigation@5"
        },
        {
          "command": "copilot-specs.linkExistingTaskToImplementation",
          "when": "view == copilot-specs.specExplorer",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.newSteering",
          "when": "view == copilot-specs.steeringExplorer",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.newHook",
          "when": "view == copilot-specs.hooksExplorer",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.refreshExplorer",
          "when": "view == copilot-specs.mcpServersExplorerSidebar",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.openMcpConfig",
          "when": "view == copilot-specs.mcpServersExplorerSidebar",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.refreshExplorer",
          "when": "view == copilot-specs.mcpServersExplorer",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.openMcpConfig",
          "when": "view == copilot-specs.mcpServersExplorer",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.todo.showFilterMenu",
          "when": "view == copilot-specs.developerTodosView",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.todo.refresh",
          "when": "view == copilot-specs.developerTodosView",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.todo.clearBranchTodos",
          "when": "view == copilot-specs.developerTodosView",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.todo.addTodo",
          "when": "view == copilot-specs.developerTodosView",
          "group": "navigation"
        },
        {
          "command": "copilot-specs.todo.selectPreset",
          "when": "view == copilot-specs.developerTodosView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "copilot-specs.evaluateSteeringFile",
          "when": "resourceExtname =~ /\\.(prompt\\.md|instructions\\.md|agent\\.md)$/ || resourceBasename == 'SKILL.md' || resourceBasename == 'copilot-instructions.md' || resourceBasename == 'AGENTS.md' || resourceBasename == 'AGENT.md'",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "copilot-specs.todo.navigateToFile",
          "when": "view == copilot-specs.developerTodosView && (viewItem == todoItem || viewItem == todoItemCompleted || viewItem == todoItemIgnored)",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.todo.completeTodo",
          "when": "view == copilot-specs.developerTodosView && (viewItem == todoItem || viewItem == todoItemBranchLevel)",
          "group": "inline@2"
        },
        {
          "command": "copilot-specs.todo.ignoreTodo",
          "when": "view == copilot-specs.developerTodosView && (viewItem == todoItem || viewItem == todoItemBranchLevel)",
          "group": "inline@3"
        },
        {
          "command": "copilot-specs.todo.reopenTodo",
          "when": "view == copilot-specs.developerTodosView && (viewItem == todoItemCompleted || viewItem == todoItemCompletedBranchLevel)",
          "group": "inline@2"
        },
        {
          "command": "copilot-specs.todo.unignoreTodo",
          "when": "view == copilot-specs.developerTodosView && (viewItem == todoItemIgnored || viewItem == todoItemIgnoredBranchLevel)",
          "group": "inline@2"
        },
        {
          "command": "copilot-specs.todo.showTemplate",
          "when": "view == copilot-specs.developerTodosView && (viewItem == todoItem || viewItem == todoItemCompleted || viewItem == todoItemIgnored || viewItem == todoItemBranchLevel || viewItem == todoItemCompletedBranchLevel || viewItem == todoItemIgnoredBranchLevel)"
        },
        {
          "command": "copilot-specs.runAllTasks",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "inline"
        },
        {
          "command": "copilot-specs.generateWithCopilot",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.runAllTasks",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "1_actions@1"
        },
        {
          "command": "copilot-specs.generateWithCopilot",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "1_actions@2"
        },
        {
          "command": "copilot-specs.renameSpec",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "2_manage@1"
        },
        {
          "command": "copilot-specs.deleteSpec",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "2_manage@2"
        },
        {
          "command": "copilot-specs.linkExistingTaskToImplementation",
          "when": "viewItem == spec || viewItem == spec-feature || viewItem == spec-bugfix || viewItem == spec-quick",
          "group": "1_actions@3"
        },
        {
          "command": "copilot-specs.openSpecFile",
          "when": "viewItem == specFile-requirements || viewItem == specFile-design || viewItem == specFile-tasks",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.checkTask",
          "when": "viewItem == task-incomplete",
          "group": "inline"
        },
        {
          "command": "copilot-specs.startTask",
          "when": "viewItem == task-incomplete",
          "group": "inline"
        },
        {
          "command": "copilot-specs.uncheckTask",
          "when": "viewItem == task-complete",
          "group": "inline"
        },
        {
          "command": "copilot-specs.runHook",
          "when": "viewItem == hook-enabled || viewItem == hook-disabled",
          "group": "inline"
        },
        {
          "command": "copilot-specs.disableHook",
          "when": "viewItem == hook-enabled",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.enableHook",
          "when": "viewItem == hook-disabled",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.disableMcpServer",
          "when": "viewItem == mcpServer-enabled",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.enableMcpServer",
          "when": "viewItem == mcpServer-disabled",
          "group": "inline@1"
        },
        {
          "command": "copilot-specs.editSteering",
          "when": "view == copilot-specs.steeringExplorer && viewItem == section-instructions",
          "group": "inline"
        },
        {
          "command": "copilot-specs.newSteering",
          "when": "view == copilot-specs.steeringExplorer && viewItem == section-rules",
          "group": "inline"
        },
        {
          "command": "copilot-specs.newSteering",
          "when": "view == copilot-specs.steeringExplorer && viewItem == section-skills",
          "group": "inline"
        },
        {
          "command": "copilot-specs.newPrompt",
          "when": "view == copilot-specs.steeringExplorer && viewItem == section-prompts",
          "group": "inline"
        },
        {
          "command": "copilot-specs.newWorkflow",
          "when": "view == copilot-specs.steeringExplorer && viewItem == section-workflows",
          "group": "inline"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "developerTodos_getRemainingTasks",
        "displayName": "Get Remaining Tasks",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "devTodos",
        "icon": "$(checklist)",
        "userDescription": "Get the list of remaining developer tasks for the current git branch",
        "modelDescription": "Gets all remaining (incomplete and not ignored) developer todos/tasks for the current git branch. Returns a list of tasks with their ID, name, description, priority, associated file path, and AI instructions if available. Use this to understand what tasks need to be completed before a feature is ready.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "all"
              ],
              "description": "Filter tasks by priority level. Use 'all' to get all priorities."
            }
          }
        }
      },
      {
        "name": "developerTodos_completeTodo",
        "displayName": "Complete Task",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "completeTodo",
        "icon": "$(check)",
        "userDescription": "Mark a developer task as completed",
        "modelDescription": "Marks a specific developer todo/task as completed. Use this after you have finished implementing or addressing the task. The task will be marked as done and moved to the completed section. Requires the exact task ID which can be obtained from getRemainingTasks.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "todoId": {
              "type": "string",
              "description": "The unique ID of the todo to complete. Get this from the getRemainingTasks tool."
            }
          },
          "required": [
            "todoId"
          ]
        }
      },
      {
        "name": "developerTodos_getTaskInstructions",
        "displayName": "Get Task Instructions",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "taskInstructions",
        "icon": "$(info)",
        "userDescription": "Get detailed AI instructions for completing a specific task",
        "modelDescription": "Gets the detailed AI instructions for a specific developer todo/task. Templates can include aiInstruction fields that provide step-by-step guidance on how to complete the task. Use this to understand exactly what needs to be done to complete a task. Returns the task details along with any AI-specific instructions defined in the template.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "todoId": {
              "type": "string",
              "description": "The unique ID of the todo to get instructions for. Get this from the getRemainingTasks tool."
            }
          },
          "required": [
            "todoId"
          ]
        }
      },
      {
        "name": "developerTodos_addTodo",
        "displayName": "Add Todo",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "addTodo",
        "icon": "$(add)",
        "userDescription": "Create a new todo task for the current git branch",
        "modelDescription": "Creates a new ad-hoc developer todo/task on the current git branch. Use this when the user or the task at hand requires tracking a new piece of work that is not already covered by an existing template-matched todo. For example: 'add a todo to write unit tests for the auth module', 'create a task to update the README', or 'remember to fix the flaky test'. Returns the newly created todo's ID which can be used with completeTodo or getTaskInstructions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Short display name for the todo (e.g. 'Write unit tests for AuthService'). Keep it concise."
            },
            "description": {
              "type": "string",
              "description": "Detailed description of what needs to be done. Be specific about the expected outcome."
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "description": "Priority level. Use 'high' for blocking or critical tasks, 'medium' for important but non-blocking, 'low' for nice-to-have. Defaults to 'medium'."
            },
            "filePath": {
              "type": "string",
              "description": "Optional absolute file path to associate the todo with a specific file. Omit for branch-level tasks that are not tied to a file."
            }
          },
          "required": [
            "name",
            "description"
          ]
        }
      },
      {
        "name": "developerTodos_completeAllBranchTasks",
        "displayName": "Complete All Branch Tasks",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "completeAllTasks",
        "icon": "$(check-all)",
        "userDescription": "Mark all remaining tasks on the current git branch as completed",
        "modelDescription": "Marks all active (incomplete and non-ignored) tasks on the current git branch as completed at once. Use this when the user asks to mark all tasks done or when all feature requirements for the branch are finished.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "copilotSpecs_listSpecs",
        "displayName": "List Feature Specs",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "listSpecs",
        "icon": "$(tasklist)",
        "userDescription": "List all feature specifications in the workspace",
        "modelDescription": "Gets a list of all feature specs in the workspace, including spec names, file globs, and task progress stats. Use this to discover active feature specifications.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "copilotSpecs_getSpecDetails",
        "displayName": "Get Feature Spec Details",
